# https://EditorConfig.org
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Match .clang-format: IndentWidth 2, UseTab Never.
[*.{c,h}]
indent_style = space
indent_size = 2

[*.{cmake,txt,yml,yaml}]
indent_style = space
indent_size = 2

[Makefile*,**/Makefile]
indent_style = tab
